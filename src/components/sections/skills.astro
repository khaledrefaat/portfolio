---
import Badge from '../common/badge.astro';
import Section from '../common/section.astro';
import SectionHeader from '../common/section-header.astro';

const categories = [
  {
    name: 'Frontend',
    skills: [
      { name: 'React', featured: true },
      { name: 'Next.js', featured: true },
      { name: 'TypeScript', featured: true },
      { name: 'Tailwind CSS' },
      { name: 'Shadcn' },
      { name: 'Zustand' },
      { name: 'Framer Motion' },
    ],
  },
  {
    name: 'Backend',
    skills: [
      { name: 'Node.js', featured: true },
      { name: 'Express.js' },
      { name: 'Payload CMS' },
    ],
  },
  {
    name: 'Database',
    skills: [
      { name: 'PostgreSQL', featured: true },
      { name: 'MongoDB' },
      { name: 'Redis' },
      { name: 'Drizzle' },
      { name: 'Prisma' },
    ],
  },
  {
    name: 'DevOps',
    skills: [
      { name: 'Docker', featured: true },
      { name: 'Nginx' },
      { name: 'GitHub Actions' },
      { name: 'Linux VPS' },
      { name: 'AWS' },
      { name: 'Vercel' },
    ],
  },
  {
    name: 'SEO & Analytics',
    skills: [
      { name: 'Technical SEO' },
      { name: 'JSON-LD' },
      { name: 'GTM' },
      { name: 'GA4' },
      { name: 'Consent Mode v2' },
    ],
  },
];
---

<Section id="skills" class="bg-background" containerClass="space-y-8">
  <SectionHeader title="My Skills & Stack" class="text-center" />

  <div
    class="mx-auto grid w-full grid-cols-[max-content_1fr] gap-x-3 gap-y-4 rounded-xl bg-secondary-background p-4 md:p-8 lg:w-3xl"
  >
    {
      categories.map((category, index) => (
        <Fragment>
          <h3 class="p-1 text-sm font-semibold text-gray-500 dark:text-gray-400">
            {category.name}
          </h3>
          <ul class="flex flex-wrap gap-1.5 p-1">
            {category.skills.map((skill) => (
              <li>
                <Badge variant={skill.featured ? 'featured' : 'default'}>{skill.name}</Badge>
              </li>
            ))}
          </ul>

          {index !== categories.length - 1 && (
            <div class="col-span-2 h-px w-full bg-gray-200 dark:bg-gray-500" />
          )}
        </Fragment>
      ))
    }
  </div>
</Section>
