---
interface Props {
  title: string;
  subTitle?: string;
  class?: string;
}

const { title, subTitle, class: className } = Astro.props;
---

{
  subTitle ? (
    <h2 class:list={['font-display text-5xl font-bold leading-10', className]}>
      <span>{title}</span> <br />
      <span class="text-3xl text-gray-500">{subTitle}</span>
    </h2>
  ) : (
    <h2 class:list={['font-display text-5xl font-bold', className]}>{title}</h2>
  )
}
