---
// Extending both ButtonHTMLAttributes and AnchorHTMLAttributes conflicts on
// `type`, so build on the shared base and add the anchor-specific props.
interface Props extends astroHTML.JSX.HTMLAttributes {
  size?: 'large' | 'medium';
  variant?: 'primary' | 'secondary';
  href?: string;
  target?: string;
  rel?: string;
}

const { size = 'medium', variant = 'primary', href, class: className, ...props } = Astro.props;

// Only external links should open in a new tab; in-page anchors must not.
const isExternal = href?.startsWith('http');

const sizeClasses = {
  large: 'px-6 py-3 text-lg',
  medium: 'px-4 py-2 text-base',
} as const;

const variantClasses = {
  primary: 'bg-foreground hover:bg-gray-900',
  secondary: 'bg-secondary hover:bg-gray-700',
} as const;

const classes = [
  'font-semibold text-secondary-background rounded-xl transition-all duration-200',
  'shadow-[0_10px_30px_rgba(0,0,0,0.3)] hover:shadow-[0_15px_40px_rgba(0,0,0,0.4)] active:shadow-[0_5px_15px_rgba(0,0,0,0.3)] active:scale-[0.98]',
  'dark:hover:text-white',
  sizeClasses[size],
  variantClasses[variant],
  className,
];
---

{
  href ? (
    <a
      href={href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class:list={classes}
      {...props}
    >
      <slot />
    </a>
  ) : (
    <button class:list={classes} {...props}>
      <slot />
    </button>
  )
}
