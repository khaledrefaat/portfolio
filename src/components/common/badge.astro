---
interface Props {
  variant?: 'default' | 'primary';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const variantClasses = {
  default: 'bg-gray-100 dark:bg-gray-800',
  primary: 'bg-background',
} as const;
---

<span
  class:list={[
    'inline-flex items-center rounded-md px-2 py-1 text-sm font-medium text-secondary-foreground ring-1 ring-inset ring-background/20',
    variantClasses[variant],
    className,
  ]}
>
  <slot />
</span>
