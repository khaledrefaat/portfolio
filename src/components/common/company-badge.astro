---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  company: {
    name: string;
    type: string;
    logo?: ImageMetadata;
  };
}

const { company } = Astro.props;
---

<div class="flex items-center gap-3">
  {
    company.logo ? (
      <Image src={company.logo} alt={company.name} width={50} height={50} class="rounded-full" />
    ) : (
      <span
        aria-hidden
        class="flex h-[50px] w-[50px] items-center justify-center rounded-full bg-gray-300 font-display font-semibold dark:bg-gray-500 dark:text-white"
      >
        {company.name.charAt(0)}
      </span>
    )
  }

  <div class="flex flex-col">
    <span class="font-display dark:text-white">{company.name}</span>
    <span class="text-sm dark:text-white/80">{company.type}</span>
  </div>
</div>
